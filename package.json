{
  "name": "leetrace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:database\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.convex.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint server frontend/src frontend/vite.config.ts convex tests e2e playwright.config.ts vitest.config.ts eslint.config.js",
    "test": "vitest run --exclude \"e2e/**\"",
    "build": "tsc -p tsconfig.server.json && mkdir -p dist/convex/_generated && cp convex/_generated/api.js dist/convex/_generated/api.js && cp server/runner-worker.py dist/server/runner-worker.py && vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env.local dist/server/index.js",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:database": "node -- node_modules/convex/bin/main.js dev --env-file .env.local",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:stress": "pnpm build && E2E_STRESS=1 node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "setup:dev": "node --env-file=.env.local scripts/configure-local.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@monaco-editor/react": "^4.7.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "convex": "^1.47.0",
    "framer-motion": "^11.11.0",
    "katex": "^0.16.47",
    "monaco-editor": "^0.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.47",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "convex-test": "^0.0.62",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
