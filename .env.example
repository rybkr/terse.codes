FRONTEND_PORT=3000
BACKEND_PORT=8000

# Development Clerk app. Never prefix private keys with VITE_.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Convex CLI writes deployment selection and URL to .env.local.
# pnpm setup:dev generates TERSE_SERVER_SECRET and configures Convex.
# Set CONVEX_URL explicitly in production.
# CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Comma-separated origins if using a remote/forwarded development address.
# Required in production and must use HTTPS there.
# APP_ORIGIN=https://terse.example.com

# Required in production after registering /webhooks/clerk.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
